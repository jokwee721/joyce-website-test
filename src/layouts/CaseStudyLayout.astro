---
import BaseLayout from './BaseLayout.astro';
import MetaGrid from '../components/MetaGrid.astro';
import { withBase } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  subtitle,
  category,
  description,
  image,
  imageAlt,
  transparentBg = true,
  tags,
  launchUrl,
  launchLabel = 'Launch Experience',
  secondaryLaunchUrl,
  secondaryLaunchLabel = 'Launch Course',
  youtubeEmbedUrl,
  figmaEmbedUrl,
  slidesEmbedUrl,
  videoEmbeds,
  accentColor,
  meta,
  gallery,
} = project.data;

const backMap = {
  lxd: { label: '← Back to Learning Experience Design', href: withBase('/all-lxd-projects') },
  uxd: { label: '← Back to User Experience Design', href: withBase('/all-ux-projects') },
  gd: { label: '← Back to Graphic Design', href: withBase('/all-graphic-design') },
};

const backLink = backMap[category];
---

<BaseLayout title={`${title} — Joyce Yang`} description={description} showNavbar={true} showFooter={true}>
  <article
    class="case-study-wrapper"
    style={accentColor ? `--primary-blue: ${accentColor};` : undefined}
  >
    <div class="case-study-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href={backLink.href} class="back-link">{backLink.label}</a>
      </nav>

      <!-- Hero Section (Inspired by uxd.html Esker Billing & Fire Safety) -->
      <section class="hero-section">
        <div class="hero-image">
          <img
            src={withBase(image)}
            alt={imageAlt}
            class={!transparentBg ? 'hero-img--white-bg' : undefined}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="hero-content">
          <h1>{title}</h1>
          {subtitle && <h2>{subtitle}</h2>}
          <p>{description}</p>

          <div class="hero-tags" aria-label="Tools Used">
            {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
          </div>

          {
            (launchUrl || secondaryLaunchUrl) && (
              <div class="hero-cta-row">
                {launchUrl && (
                  <a
                    href={withBase(launchUrl)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="launch-btn"
                  >
                    {launchLabel} ↗
                  </a>
                )}
                {secondaryLaunchUrl && (
                  <a
                    href={withBase(secondaryLaunchUrl)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="launch-btn launch-btn--secondary"
                  >
                    {secondaryLaunchLabel} ↗
                  </a>
                )}
              </div>
            )
          }
        </div>
      </section>

      <!-- 5-Column Metadata Grid -->
      {meta && <MetaGrid items={meta} />}

      <!-- Markdown Case Study Body -->
      <div class="case-study-prose">
        <slot />
      </div>

      <!-- Optional Google Drive / External Video Embeds -->
      {
        videoEmbeds && videoEmbeds.length > 0 && (
          <section class="embed-section" aria-label="Project Video Demonstrations">
            <h2 class="gallery-heading">Video Demonstrations</h2>
            <div class="video-embeds-grid">
              {videoEmbeds.map((vid) => (
                <figure
                  class={`video-embed-card ${vid.aspect === 'vertical' ? 'video-embed-card--vertical' : ''}`}
                  data-video-src={vid.src}
                >
                  <div class={`responsive-iframe ${vid.aspect === 'vertical' ? 'responsive-iframe--vertical' : ''}`}>
                    <iframe
                      src={vid.src}
                      title={vid.title}
                      loading="lazy"
                      allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                  {vid.caption && <figcaption class="video-embed-caption">{vid.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <!-- Optional Embedded YouTube / Figma Blocks -->
      {
        youtubeEmbedUrl && (
          <section class="embed-section" aria-label="Video Demonstration">
            <div class="responsive-iframe">
              <iframe
                src={youtubeEmbedUrl}
                title={`${title} Video Demonstration`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          </section>
        )
      }

      {
        figmaEmbedUrl && (
          <section class="embed-section" aria-label="Interactive Figma Prototype">
            <h2 class="gallery-heading">Interactive Prototype</h2>
            <div class="responsive-iframe">
              <iframe
                src={figmaEmbedUrl}
                title={`${title} Interactive Figma Prototype`}
                loading="lazy"
                allowfullscreen
              />
            </div>
          </section>
        )
      }

      {
        slidesEmbedUrl && (
          <section class="embed-section" aria-label="Presentation Deck">
            <h2 class="gallery-heading">Finalist Presentation Deck</h2>
            <div class="responsive-iframe">
              <iframe
                src={slidesEmbedUrl}
                title={`${title} Presentation Slides`}
                loading="lazy"
                allowfullscreen
              />
            </div>
          </section>
        )
      }

      <!-- Optional Visual Gallery -->
      {
        gallery && gallery.length > 0 && (
          <section class="gallery-section" aria-label="Project Screenshots and Visual Artifacts">
            <h2 class="gallery-heading">Project Visuals &amp; Screens</h2>
            <div class="gallery-grid">
              {gallery.map((item) => {
                const fullSrc = withBase(item.src);
                return (
                  <figure class="gallery-item">
                    <a
                      href={fullSrc}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="gallery-zoom-trigger"
                      data-full-src={fullSrc}
                      data-alt={item.alt}
                      data-caption={item.caption || ''}
                      aria-label={`Enlarge image: ${item.alt}`}
                    >
                      <img src={fullSrc} alt={item.alt} loading="lazy" decoding="async" />
                      <span class="zoom-badge" aria-hidden="true">Enlarge ⤢</span>
                    </a>
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                );
              })}
            </div>
          </section>
        )
      }

      <footer class="case-study-bottom-nav">
        <a href={backLink.href} class="outline-back-btn">{backLink.label}</a>
      </footer>
    </div>

    <!-- Natural-Resolution Lightbox Modal -->
    <div
      id="gallery-lightbox"
      class="lightbox-backdrop"
      role="dialog"
      aria-modal="true"
      aria-label="Enlarged Project Visual"
      hidden
    >
      <div class="lightbox-toolbar">
        <a
          id="lightbox-new-tab"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="lightbox-action-btn"
        >
          Open in New Tab ↗
        </a>
        <button
          id="lightbox-close"
          type="button"
          class="lightbox-close-btn"
          aria-label="Close enlarged image (Esc)"
        >
          ✕ Close
        </button>
      </div>

      <figure class="lightbox-figure">
        <img id="lightbox-img" src="" alt="" class="lightbox-img" />
        <figcaption id="lightbox-caption" class="lightbox-caption"></figcaption>
      </figure>
    </div>
  </article>
</BaseLayout>

<script>
  /**
   * Automatically detects the native aspect ratio (vertical vs. landscape & exact width/height)
   * of Google Drive video embeds via Google Drive's thumbnail endpoint so videos never show huge black bars.
   */
  function autoSizeVideoEmbeds() {
    const cards = document.querySelectorAll<HTMLElement>('.video-embed-card[data-video-src]');
    cards.forEach((card) => {
      const src = card.dataset.videoSrc || '';
      const match = src.match(/\/file\/d\/([^/]+)/);
      if (!match) return;

      const fileId = match[1];
      const frameBox = card.querySelector<HTMLElement>('.responsive-iframe');
      if (!frameBox) return;

      const probe = new Image();
      probe.onload = () => {
        if (probe.naturalWidth > 0 && probe.naturalHeight > 0) {
          const isVertical = probe.naturalHeight > probe.naturalWidth;
          card.classList.toggle('video-embed-card--vertical', isVertical);
          frameBox.classList.toggle('responsive-iframe--vertical', isVertical);
          frameBox.style.paddingBottom = `${((probe.naturalHeight / probe.naturalWidth) * 100).toFixed(2)}%`;
        }
      };
      probe.src = `https://drive.google.com/thumbnail?id=${fileId}&sz=w800`;
    });
  }

  autoSizeVideoEmbeds();

  /**
   * Natural-Resolution Lightbox for Project Visuals & Screens:
   * - Opens on click (while preserving Cmd/Ctrl+Click to open in a new tab).
   * - Caps image display width/height at 100% of its native pixel resolution so it never stretches or blurs.
   */
  function initGalleryLightbox() {
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxNewTab = document.getElementById('lightbox-new-tab') as HTMLAnchorElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const triggers = document.querySelectorAll<HTMLAnchorElement>('.gallery-zoom-trigger');

    if (!lightbox || !lightboxImg || !triggers.length) return;

    // Mount at document.body root so the modal always layers above sticky headers
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    function openLightbox(src: string, alt: string, caption: string, thumbImg?: HTMLImageElement | null) {
      if (!lightbox || !lightboxImg) return;

      // Apply natural resolution cap immediately if thumbnail is already loaded
      if (thumbImg && thumbImg.naturalWidth > 0) {
        lightboxImg.style.maxWidth = `min(92vw, ${thumbImg.naturalWidth}px)`;
        lightboxImg.style.maxHeight = `min(82vh, ${thumbImg.naturalHeight}px)`;
      } else {
        lightboxImg.style.maxWidth = '92vw';
        lightboxImg.style.maxHeight = '82vh';
      }

      lightboxImg.onload = () => {
        if (lightboxImg.naturalWidth > 0) {
          lightboxImg.style.maxWidth = `min(92vw, ${lightboxImg.naturalWidth}px)`;
          lightboxImg.style.maxHeight = `min(82vh, ${lightboxImg.naturalHeight}px)`;
        }
      };

      lightboxImg.src = src;
      lightboxImg.alt = alt;
      if (lightboxCaption) {
        lightboxCaption.textContent = caption || alt;
      }
      if (lightboxNewTab) {
        lightboxNewTab.href = src;
      }

      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.hidden = true;
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        // Allow Cmd/Ctrl+Click or middle-click to open directly in a new tab
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        e.preventDefault();
        const src = trigger.dataset.fullSrc || trigger.href;
        const alt = trigger.dataset.alt || '';
        const caption = trigger.dataset.caption || '';
        const thumbImg = trigger.querySelector('img');
        openLightbox(src, alt, caption, thumbImg);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      // Close when clicking the dark backdrop outside the image/toolbar
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-figure')) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) {
        closeLightbox();
      }
    });
  }

  initGalleryLightbox();
</script>

<style>
  .case-study-wrapper {
    background: var(--bg-surface);
    padding: 40px 20px 88px 20px;
  }

  .case-study-container {
    max-width: 1280px;
    margin: 0 auto;
    background: var(--card-bg);
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
    padding: 52px 68px;
  }

  .breadcrumb-nav {
    margin-bottom: 32px;
  }

  .back-link {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--primary-blue);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
    text-decoration: underline;
  }

  /* Hero Section */
  .hero-section {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    margin-bottom: 48px;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image img {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
    border-radius: 12px;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.12));
  }

  .hero-image img.hero-img--white-bg {
    filter: none;
    mix-blend-mode: multiply;
  }

  .hero-content h1 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    color: var(--primary-blue);
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .hero-content h2 {
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .hero-content p {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.78;
    margin-bottom: 20px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .tag-pill {
    background: var(--primary-blue-soft);
    color: var(--primary-blue);
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 600;
  }

  .hero-cta-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .launch-btn,
  .launch-btn--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #ffffff;
    color: var(--primary-blue);
    border: 2px solid var(--primary-blue);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .launch-btn:hover,
  .launch-btn--secondary:hover {
    background: var(--primary-blue);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px var(--primary-blue-shadow);
  }

  /* Case Study Prose */
  .case-study-prose {
    border-top: 1px solid var(--border-subtle);
    padding-top: 40px;
    font-size: 1.04rem;
    line-height: 1.8;
    color: var(--text-main);
  }

  .case-study-prose :global(h2) {
    font-size: 1.65rem;
    color: var(--primary-blue);
    font-weight: 800;
    margin: 36px 0 14px 0;
  }

  .case-study-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study-prose :global(h3) {
    font-size: 1.25rem;
    color: var(--text-pure-black);
    font-weight: 700;
    margin: 28px 0 10px 0;
  }

  .case-study-prose :global(p) {
    margin: 0 0 18px 0;
    color: var(--text-muted);
  }

  .case-study-prose :global(ul),
  .case-study-prose :global(ol) {
    margin: 0 0 24px 0;
    padding-left: 24px;
    color: var(--text-muted);
  }

  .case-study-prose :global(li) {
    margin-bottom: 12px;
  }

  .case-study-prose :global(strong) {
    color: var(--text-pure-black);
    font-weight: 700;
  }

  /* Gallery */
  .gallery-section {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border-subtle);
  }

  .gallery-heading {
    font-size: 1.5rem;
    color: var(--primary-blue);
    font-weight: 800;
    margin-bottom: 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .gallery-item {
    margin: 0;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.25s var(--ease-smooth), box-shadow 0.25s var(--ease-smooth), border-color 0.25s ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: rgba(51, 33, 255, 0.25);
  }

  .gallery-zoom-trigger {
    position: relative;
    display: block;
    border-radius: 8px;
    overflow: hidden;
    cursor: zoom-in;
    text-decoration: none;
  }

  .gallery-item img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    transition: transform 0.35s var(--ease-smooth);
  }

  .gallery-zoom-trigger:hover img {
    transform: scale(1.015);
  }

  .zoom-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(15, 23, 42, 0.78);
    backdrop-filter: blur(6px);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .gallery-zoom-trigger:hover .zoom-badge,
  .gallery-zoom-trigger:focus-visible .zoom-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-item figcaption {
    font-size: 0.88rem;
    color: var(--text-subtle);
    text-align: center;
  }

  /* Natural-Resolution Lightbox Modal */
  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(10, 12, 20, 0.92);
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .lightbox-backdrop[hidden] {
    display: none !important;
  }

  @keyframes fadeInLightbox {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lightbox-toolbar {
    position: absolute;
    top: 20px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 2001;
  }

  .lightbox-action-btn,
  .lightbox-close-btn {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 13.5px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .lightbox-action-btn:hover,
  .lightbox-close-btn:hover {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
  }

  .lightbox-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    max-width: 92vw;
    max-height: 88vh;
  }

  .lightbox-img {
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
    background: #ffffff;
  }

  .lightbox-caption {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.95rem;
    text-align: center;
    max-width: 720px;
  }

  /* Responsive Iframe & Video Embeds */
  .embed-section {
    margin-top: 40px;
    padding-top: 36px;
    border-top: 1px solid var(--border-subtle);
  }

  .video-embeds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
    align-items: start;
  }

  .video-embed-card {
    margin: 0;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .video-embed-card--vertical {
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }

  .video-embed-caption {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
  }

  .responsive-iframe {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    background: #0f172a;
  }

  .responsive-iframe--vertical {
    padding-bottom: 177.78%;
  }

  .responsive-iframe iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .case-study-bottom-nav {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: flex-start;
  }

  .outline-back-btn {
    border: 1.5px solid var(--primary-blue);
    color: var(--primary-blue);
    padding: 11px 22px;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .outline-back-btn:hover {
    background: var(--primary-blue);
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .case-study-container {
      padding: 36px 28px;
    }

    .hero-section {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .case-study-container {
      padding: 24px 18px;
    }
  }
</style>
