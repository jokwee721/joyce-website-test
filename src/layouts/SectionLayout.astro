---
import BaseLayout from './BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  heading?: string;
  subtitle?: string;
  projects: CollectionEntry<'projects'>[];
}

const { title, heading = 'Featured Projects', subtitle, projects } = Astro.props;
const sortedProjects = [...projects].sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} showNavbar={true} showFooter={true}>
  <section class="section-container">
    <header class="section-header gallery-reveal" data-delay="0">
      <h1 class="page-title">{heading}</h1>
      {subtitle && <p class="page-subtitle">{subtitle}</p>}
    </header>

    <div class="project-grid">
      {
        sortedProjects.map((project, index) => (
          <div class="project-grid__item gallery-reveal" data-delay={String((index % 2) * 110)}>
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              imageWidth={project.data.imageWidth}
              transparentBg={project.data.transparentBg}
              tags={project.data.tags}
              ctaLabel={project.data.ctaLabel}
            />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  function initGalleryReveal() {
    const items = document.querySelectorAll<HTMLElement>('.gallery-reveal');
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = Number(el.dataset.delay || '0');
            el.style.transitionDelay = `${delay}ms`;
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px',
      }
    );

    items.forEach((el) => observer.observe(el));
  }

  initGalleryReveal();
  document.addEventListener('astro:after-swap', initGalleryReveal);
</script>

<style>
  .section-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 48px 32px 96px 32px;
    width: 100%;
  }

  .section-header {
    margin-bottom: 48px;
  }

  .page-title {
    text-align: left;
    font-size: clamp(32px, 6vw, 54px);
    font-weight: 800;
    margin: 0;
    color: var(--text-pure-black);
  }

  .page-subtitle {
    margin: 12px 0 0 0;
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 720px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 40px;
    align-items: stretch;
    width: 100%;
  }

  .project-grid__item {
    display: flex;
    height: 100%;
  }

  .gallery-reveal {
    opacity: 0;
    transform: translate3d(0, 36px, 0);
    transition:
      opacity 0.75s var(--ease-out-expo),
      transform 0.75s var(--ease-out-expo);
    will-change: opacity, transform;
  }

  .gallery-reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (min-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .section-container {
      padding: 32px 18px 64px 18px;
    }
  }
</style>
