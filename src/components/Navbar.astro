---
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

interface NavDropdownItem {
  label: string;
  href: string;
}

interface NavGroup {
  label: string;
  href: string;
  matchPrefix: string[];
  items?: NavDropdownItem[];
}

const allProjects = await getCollection('projects');
const getCategoryItems = (cat: 'lxd' | 'uxd' | 'gd', allLabel: string, allHref: string): NavDropdownItem[] => {
  const catProjects = allProjects
    .filter((p) => p.data.category === cat && p.data.listed !== false)
    .sort((a, b) => a.data.order - b.data.order);

  return [
    { label: allLabel, href: allHref },
    ...catProjects.map((p) => ({
      label: p.data.title,
      href: `/${p.id}`,
    })),
  ];
};

const getCategoryPrefixes = (cat: 'lxd' | 'uxd' | 'gd', allHref: string): string[] => [
  allHref,
  ...allProjects.filter((p) => p.data.category === cat).map((p) => `/${p.id}`),
];

const rawPath = Astro.url.pathname;
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const strippedPath = basePrefix && rawPath.startsWith(basePrefix) ? rawPath.slice(basePrefix.length) : rawPath;
const currentPath = strippedPath.replace(/\/$/, '') || '/';

const navGroups: NavGroup[] = [
  {
    label: 'Learning Experience Design',
    href: '/all-lxd-projects',
    matchPrefix: getCategoryPrefixes('lxd', '/all-lxd-projects'),
    items: getCategoryItems('lxd', 'All LXD Projects', '/all-lxd-projects'),
  },
  {
    label: 'User Experience Design',
    href: '/all-ux-projects',
    matchPrefix: getCategoryPrefixes('uxd', '/all-ux-projects'),
    items: getCategoryItems('uxd', 'All UX Projects', '/all-ux-projects'),
  },
  {
    label: 'Graphic Design',
    href: '/all-graphic-design',
    matchPrefix: getCategoryPrefixes('gd', '/all-graphic-design'),
    items: getCategoryItems('gd', 'All Graphic Design Projects', '/all-graphic-design'),
  },
  {
    label: 'Resume',
    href: '/resume',
    matchPrefix: ['/resume'],
  },
];
---

<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a href={withBase('/')} class="brand-logo" aria-label="Joyce Yang Home">
      <span class="brand-logo__box">JY</span>
    </a>

    <button
      class="mobile-menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Toggle navigation menu"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <nav id="primary-navigation" class="site-nav" aria-label="Primary Navigation">
      <ul class="site-nav__list">
        {
          navGroups.map((group) => {
            const isActive = group.matchPrefix.includes(currentPath);
            return (
              <li class={`site-nav__item ${group.items ? 'has-dropdown' : ''}`}>
                <a
                  href={withBase(group.href)}
                  class={`site-nav__link ${isActive ? 'is-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {group.label}
                  {group.items && (
                    <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                      <path
                        d="M2.5 4.5L6 8L9.5 4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </a>

                {group.items && (
                  <ul class="dropdown-menu" aria-label={`${group.label} sub-pages`}>
                    {group.items.map((item) => {
                      const isSubActive = currentPath === item.href;
                      return (
                        <li>
                          <a
                            href={withBase(item.href)}
                            class={`dropdown-link ${isSubActive ? 'is-sub-active' : ''}`}
                            aria-current={isSubActive ? 'page' : undefined}
                          >
                            {item.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function initMobileNav() {
    const btn = document.querySelector('.mobile-menu-btn');
    const nav = document.querySelector('.site-nav');
    if (!btn || !nav) return;

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open', !expanded);
    });
  }

  initMobileNav();
  document.addEventListener('astro:after-swap', initMobileNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-navbar);
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .site-header__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 16px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand-logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border: 2px solid var(--text-pure-black);
    background: #ffffff;
    transition: transform 0.25s var(--ease-smooth);
  }

  .brand-logo:hover {
    transform: scale(1.04);
  }

  .brand-logo__box {
    width: 42px;
    height: 42px;
    background: var(--text-pure-black);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.5px;
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
    color: var(--primary-blue);
    text-decoration: none;
    padding: 8px 2px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: relative;
    transition: color 0.2s ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 0%;
    height: 2px;
    background: var(--primary-blue);
    transition: width 0.25s var(--ease-smooth);
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    width: 100%;
  }

  .site-nav__link.is-active {
    font-weight: 700;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  .site-nav__item:hover .dropdown-chevron,
  .site-nav__item:focus-within .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 285px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.11);
    border: 1px solid rgba(51, 33, 255, 0.1);
    padding: 10px;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 1001;
  }

  .site-nav__item::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 10px;
  }

  .site-nav__item:hover .dropdown-menu,
  .site-nav__item:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-main);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover,
  .dropdown-link.is-sub-active {
    background: var(--primary-blue-soft);
    color: var(--primary-blue);
    font-weight: 600;
  }

  /* Mobile Hamburger */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: 1.5px solid var(--primary-blue);
    border-radius: 8px;
    padding: 8px 10px;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background: var(--primary-blue);
    border-radius: 2px;
  }

  @media (max-width: 960px) {
    .site-header__inner {
      padding: 14px 20px;
    }

    .mobile-menu-btn {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #ffffff;
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);
      padding: 20px 24px;
      border-top: 1px solid var(--border-subtle);
      max-height: 80vh;
      overflow-y: auto;
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      padding: 6px 0 0 12px;
      border-left: 2px solid var(--primary-blue-soft);
      border-radius: 0;
    }
  }
</style>
