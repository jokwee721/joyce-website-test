---
interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  items: MetaItem[];
}

const { items } = Astro.props;
---

{
  items && items.length > 0 && (
    <section class="meta-grid" aria-label="Project Summary Metadata">
      {items.map((item) => (
        <div class="meta-card">
          <span class="meta-label">{item.label}</span>
          <div class="meta-value">{item.value}</div>
        </div>
      ))}
    </section>
  )
}

<style>
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
    gap: 20px;
    padding-top: 36px;
    margin-bottom: 48px;
    border-top: 1px solid var(--border-subtle);
  }

  .meta-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 22px 20px;
    text-align: left;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .meta-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(51, 33, 255, 0.08);
    border-color: var(--primary-blue);
  }

  .meta-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary-blue);
    font-weight: 700;
    margin-bottom: 8px;
    display: block;
  }

  .meta-value {
    font-size: 0.95rem;
    color: var(--text-main);
    font-weight: 400;
    line-height: 1.45;
  }
</style>
