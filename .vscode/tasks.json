{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Live Preview Server (Astro)",
      "type": "shell",
      "command": "npm.cmd run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*astro.*",
          "endsPattern": ".*Local.*http://localhost:4321.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run Full QA Check (Spell + Links + Build)",
      "type": "shell",
      "command": "npm.cmd run qa",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
